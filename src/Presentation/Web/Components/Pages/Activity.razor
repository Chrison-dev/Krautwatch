@page "/activity"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IServiceScopeFactory Scopes
@using Krautwatch.Application.Downloads

<PageTitle>Activity · Krautwatch</PageTitle>

<h1>Activity</h1>

@if (_notice is not null)
{
    <p class="error" role="status">@_notice</p>
}

@if (_jobs is null)
{
    <p class="muted">Loading…</p>
}
else if (_jobs.Count == 0)
{
    <p class="muted">No downloads yet — queue one from <a href="search">Search</a>.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Show</th><th>Episode</th><th>Status</th><th>Progress</th><th>File</th><th class="right">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var j in _jobs)
            {
                <tr>
                    <td>
                        @j.ShowTitle
                        @if (j.GeoRestricted)
                        {
                            <span class="geo" title="DACH geo-restricted — fetched via a German egress proxy (#45)">🌍 DACH</span>
                        }
                    </td>
                    <td>@j.EpisodeTitle</td>
                    <td><span class="status @StatusClass(j)">@j.Status</span></td>
                    <td>
                        @if (j.Active && j.ProgressPercent is > 0)
                        {
                            var pct = (int)j.ProgressPercent!.Value;
                            <div class="bar"><div class="fill" style="width:@(pct)%"></div></div>
                            <span class="muted small">@pct%</span>
                        }
                        else if (j.Status == "Completed")
                        {
                            <span class="ok">✓</span>
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                    <td class="path muted small">@(j.OutputPath ?? j.ErrorMessage ?? "")</td>
                    <td class="right actions">
                        @* Only queued jobs can be reordered, and only when there is something to move
                           past — a control that cannot change anything should not be offered. *@
                        @if (j.Status == "Queued" && _queuedCount > 1)
                        {
                            <button class="icon-btn" title="Move to top of queue"
                                    @onclick="() => ReorderAsync(j.JobId, QueueMove.ToTop)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
                            </button>
                            <button class="icon-btn" title="Move to bottom of queue"
                                    @onclick="() => ReorderAsync(j.JobId, QueueMove.ToBottom)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
                            </button>
                        }
                        @if (j.Active)
                        {
                            <button class="icon-btn danger" title="Cancel download" @onclick="() => CancelAsync(j.JobId)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            </button>
                        }
                        @if (!j.Active && j.Status != "Completed")
                        {
                            <button class="icon-btn" title="Retry download" @onclick="() => RetryAsync(j.JobId)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                            </button>
                        }
                        @if (!j.Active)
                        {
                            <button class="icon-btn danger" title="Remove from list" @onclick="() => DeleteAsync(j.JobId)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    IReadOnlyList<DownloadJobResponse>? _jobs;
    PeriodicTimer? _timer;

    // Reorder controls only appear when there is more than one queued job to move between.
    int _queuedCount;

    // Set when a reorder is refused — e.g. the job started downloading before the click landed.
    string? _notice;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollAsync();
    }

    async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync())
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* disposed */ }
    }

    async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var handler = scope.ServiceProvider.GetRequiredService<GetDownloadQueueHandler>();
        _jobs = await handler.HandleAsync();
        _queuedCount = _jobs.Count(j => j.Status == "Queued");
    }

    // Move a queued job to the top or bottom of the queue (#51). The handler refuses anything no longer
    // queued — which the 3s poll makes reachable: a job can start downloading between render and click.
    async Task ReorderAsync(Guid jobId, QueueMove move)
    {
        _notice = null;
        using var scope = Scopes.CreateScope();
        var result = await scope.ServiceProvider
            .GetRequiredService<ReorderDownloadHandler>().HandleAsync(jobId, move);

        if (!result.Ok) _notice = result.Problem;
        await RefreshAsync();
    }

    // Re-queue a failed job (a fresh attempt runs) and drop the old failed row so the list stays tidy.
    async Task RetryAsync(Guid jobId)
    {
        using var scope = Scopes.CreateScope();
        await scope.ServiceProvider.GetRequiredService<RetryDownloadHandler>().HandleAsync(jobId);
        await scope.ServiceProvider.GetRequiredService<DeleteDownloadHandler>().HandleAsync(jobId);
        await RefreshAsync();
    }

    async Task DeleteAsync(Guid jobId)
    {
        using var scope = Scopes.CreateScope();
        await scope.ServiceProvider.GetRequiredService<DeleteDownloadHandler>().HandleAsync(jobId);
        await RefreshAsync();
    }

    // Mark the job Cancelled — a Queued job is then never claimed; a Downloading one is aborted by
    // the Downloader when it next polls (within a few seconds).
    async Task CancelAsync(Guid jobId)
    {
        using var scope = Scopes.CreateScope();
        await scope.ServiceProvider.GetRequiredService<CancelDownloadHandler>().HandleAsync(jobId);
        await RefreshAsync();
    }

    static string StatusClass(DownloadJobResponse j) =>
        j.Status == "Completed" ? "done" : j.Active ? "active" : "failed";

    public void Dispose() => _timer?.Dispose();
}
