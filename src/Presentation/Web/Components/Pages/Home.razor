@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@using Krautwatch.Application.Settings

<PageTitle>Krautwatch</PageTitle>

<h1>Krautwatch</h1>
<p class="lead">
    A self-hosted indexer + downloader for German public TV. Search what the crawlers have found,
    queue a download, and watch it land on disk — no Sonarr or Radarr required.
</p>

<div class="cards">
    <a class="card" href="search">
        <h3>Search →</h3>
        <p>Find crawled episodes across ARD, ZDF and KiKA, and download one with a click.</p>
    </a>
    <a class="card" href="activity">
        <h3>Activity →</h3>
        <p>Monitor download progress and see what's already on disk.</p>
    </a>
</div>

<p class="muted small">
    Wiring Krautwatch into Sonarr/Radarr? It also exposes a Newznab indexer and a SABnzbd download
    client — this UI is just the standalone way in.
</p>

@code {
    // Send a signed-in operator into first-run setup until it is finished (#54). Placed on the root
    // rather than in middleware so it applies to the one page every route eventually lands on, without
    // intercepting the wizard, the auth pages or the *arr-facing surfaces.
    protected override async Task OnInitializedAsync()
    {
        using var scope = Scopes.CreateScope();
        var state = await scope.ServiceProvider.GetRequiredService<SetupWizardStateHandler>().HandleAsync();

        if (state.Required && state.AdministratorExists)
            Nav.NavigateTo($"setup/{state.ResumeAt}", replace: true);
    }
}
