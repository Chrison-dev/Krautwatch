<Project Sdk="Microsoft.NET.Sdk">

  <!-- Keep in lockstep with the Aspire.Hosting* PackageVersions in Directory.Packages.props: this SDK
       pins Aspire.Hosting.AppHost + the DCP orchestrator + dashboard, and DCP refuses to start if it
       is older than Aspire.Hosting. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- Emits the production docker-compose.yaml from this same model (DR-003), so the deployed
         topology cannot drift from the one the dev fleet runs. -->
    <PackageReference Include="Aspire.Hosting.Docker" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Migrator\Krautwatch.Migrator.csproj" />
    <ProjectReference Include="..\Api\NewznabIndexerApi\Krautwatch.Api.NewznabIndexerApi.csproj" />
    <ProjectReference Include="..\Web\Krautwatch.Web.csproj" />
    <ProjectReference Include="..\Agents\Ard\Krautwatch.Agents.Ard.csproj" />
    <ProjectReference Include="..\Agents\Zdf\Krautwatch.Agents.Zdf.csproj" />
    <ProjectReference Include="..\Agents\Downloader\Krautwatch.Agents.Downloader.csproj" />
  </ItemGroup>

</Project>
